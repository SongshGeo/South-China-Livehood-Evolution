[flake8]
# Single source of truth for flake8; the pre-commit hook reads this file
# instead of carrying its own inline args. Aligned with black's line length.
max-line-length = 88
extend-ignore = E203, E231, E266, E501, W503, F403, F405, F401
max-complexity = 18
exclude =
        .git,
        __pycache__,
        build,
        dist,
        .venv,
        docs-docusaurus
